{
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "rootDir": ".",
  "setupFiles": ["<rootDir>/jest.setup-env.ts"],
  "setupFilesAfterEnv": ["<rootDir>/jest.setup-full-profile-grants-sentinel.ts"],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
