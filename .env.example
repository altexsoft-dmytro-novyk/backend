# App
PORT=3001
CORS_ORIGIN=http://localhost:4200
LOG_LEVEL=info

# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Seed (npm run db:seed) — bootstrap user's work email
ROOT_WORK_EMAIL=root@company.example

# Object storage (S3-compatible). Local dev/CI point at LocalStack via
# AWS_ENDPOINT_URL; unset AWS_ENDPOINT_URL in prod to use real AWS.
AWS_REGION=us-east-1
AWS_S3_BUCKET=user-management-photos
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test


# Local only
LOCALSTACK_PORT=4566
AWS_ENDPOINT_URL=http://localhost:4566
LOCALSTACK_AUTH_TOKEN=token

# ── Epic 2: Magic-Link Authentication ──────────────────────────────
# Story 2.1 — magic-link request + delivery
MAGIC_LINK_TTL_MINUTES=15
APP_BASE_URL=http://localhost:4200
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@company.example

# Story 2.2 — session establishment (stateless HS256 JWT, no Session table)
SESSION_JWT_SECRET=dev-only-insecure-session-secret-change-me   # REQUIRED in production (no default there); min 16 chars
SESSION_TTL_HOURS=8
# ALLOW_TEST_SESSION_TOKENS=true                                  # non-prod only: also accept `Bearer <token:<persona>>` e2e shorthand; forced false when NODE_ENV=production

# Epic 5 — Departure (AD-20)
BUSINESS_TIME_ZONE=Europe/London
DEPARTURE_WORKER_ENABLED=true
DEPARTURE_WORKER_POLL_MS=60000