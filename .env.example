# App
PORT=3001
CORS_ORIGIN=http://localhost:4200

# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Seed (npm run db:seed) — bootstrap user's work email
ROOT_WORK_EMAIL=root@company.example

# Magic-link sign-in email (Epic 2). APP_BASE_URL is the frontend origin the
# link points back to. SMTP_* is a plain nodemailer transport — point it at
# any SMTP relay the machine can reach. Leave SMTP_HOST unset to just log the
# link to the server console instead of sending.
APP_BASE_URL=http://localhost:4200
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM=People Platform <no-reply@people.local>

# Object storage (S3-compatible). Local dev/CI point at LocalStack via
# AWS_ENDPOINT_URL; unset AWS_ENDPOINT_URL in prod to use real AWS.
AWS_REGION=us-east-1
AWS_S3_BUCKET=user-management-photos
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test


# Local only
LOCALSTACK_PORT=4566
AWS_ENDPOINT_URL=http://localhost:4566
LOCALSTACK_AUTH_TOKEN=token