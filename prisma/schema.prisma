generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS runs on CommonJS — without this the generated client is ESM and breaks the build
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid(7))
  firstName       String
  lastName        String
  photo           String?
  position        String
  country         String
  // Nullable: the seeded-population import (Story 1.1) has no source column for
  // city (decisions §5) and stores it null; request-level writers still set it.
  city            String?
  workEmail       String    @unique
  workPhone       String?
  birthDay        Int?      // 1-31. No year captured/stored, for any audience (§3.2 S1: "birthday (day and month)")
  birthMonth      Int?      // 1-12, paired with birthDay
  companyJoinDate DateTime  @db.Date
  isActive        Boolean   @default(true)
  ttId            String?   @unique
  // Interim jsonb bag ahead of the dynamic custom-fields system — don't build
  // persistence assuming this shape survives (see domain-driven-design.md).
  customFields    Json      @default("{}")
  createdAt       DateTime  @default(now())
  createdBy       String
  creator         User      @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers    User[]    @relation("UserCreatedBy")

  // Org facts live in `Relationship`, never as columns here (AD-11): a manager
  // pointer on the profile row is the stored-access mistake the audience walk exists to avoid.
  relationships     Relationship[] @relation("RelationshipSubject")
  incomingRelations Relationship[] @relation("RelationshipReportsTo")

  // Access Control attachments. Back-relations only: Prisma requires them for
  // the foreign keys below, and no User Management behavior reads them.
  userPolicies      UserPolicy[]
  bootstrapRootOf   AccessControlBootstrap?

  // Story 1.1 seeded-population import. Back-relations only: Prisma requires
  // them for the foreign keys below. Department is derived, never a column here
  // (AD-11) — it reads through DepartmentMembership.
  departmentMemberships DepartmentMembership[]
  employmentStatuses    EmploymentStatus[]
  events                UserEvent[]           @relation("UserEventSubject")
  authoredEvents        UserEvent[]           @relation("UserEventAuthor")

  // Epic 2 Story 2.1 — magic-link authentication. Back-relation only.
  magicLinkTokens MagicLinkToken[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Epic 2 Story 2.1 — Magic-Link Authentication (auth sub-area of user-management,
// database-schema.md §MagicLinkToken).
//
// `tokenHash` (SHA-256 hex of the raw token) is a deliberate hardening over
// `epic-2-context.md`'s `token`-unique draft: the DB never stores the usable
// secret — the raw token exists only inside the emailed link. Flagged for
// architect ratification in database-schema.md.
// ---------------------------------------------------------------------------
model MagicLinkToken {
  id         String    @id @default(uuid(7))
  userId     String
  tokenHash  String    @unique // SHA-256 hex of the raw token; the raw token is only ever in the emailed link
  expiresAt  DateTime  @db.Timestamptz
  consumedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("magic_link_token")
}

// ---------------------------------------------------------------------------
// Story 1.1 — seeded-population import (AD-16, database-schema.md §Project/
// Department, §EmploymentStatus, §UserEvents).
//
// Prisma cannot express the partial unique indexes
// (`department_membership (userId, departmentId) WHERE validTo IS NULL`,
// `employment_status (userId) WHERE validTo IS NULL`) or the relaxed
// `employment_status` CHECK — those live in reviewed raw SQL in the migration.
// Read the migration alongside these models.
// ---------------------------------------------------------------------------

// A first-class nested org entity. Created on import when no row with the same
// (externalId, name) pair exists; `externalId` alone is NOT unique. `parentId`
// is null on import — hierarchy is assigned later (no CSV source column).
model Department {
  id         String  @id @default(uuid(7))
  name       String
  externalId String? // timetracker DepartmentId, stored as a string; NOT unique on its own
  parentId   String?

  parent      Department?            @relation("DeptTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Department[]           @relation("DeptTree")
  memberships DepartmentMembership[]

  @@unique([externalId, name])
  @@map("department")
}

model DepartmentMembership {
  id           String    @id @default(uuid(7))
  userId       String
  departmentId String
  validFrom    DateTime  @db.Date
  validTo      DateTime? @db.Date

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([departmentId])
  // UNIQUE (userId, departmentId) WHERE validTo IS NULL — raw SQL in the migration.
  @@map("department_membership")
}

// Temporal S4 employment fact (AD-16) — never `User.isActive`. An import-origin
// `dismissed` row has no `Departure`: the CHECK no longer requires
// `sourceDepartureId` / `departureReason` (database-schema.md §EmploymentStatus,
// "Import-origin dismissals (2026-09-02)").
model EmploymentStatus {
  id                String    @id @default(uuid(7))
  userId            String
  status            String // 'active' | 'dismissed'
  validFrom         DateTime  @db.Date
  validTo           DateTime? @db.Date
  departureReason   String?
  // Plain nullable column for now — the FK to `Departure` lands with AD-20 / Epic 5.
  sourceDepartureId String?   @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // UNIQUE (userId) WHERE validTo IS NULL + the relaxed status CHECK — raw SQL in the migration.
  @@map("employment_status")
}

// The §4.9 career-timeline log (database-schema.md §UserEvents). Immutable
// facts: no updatedAt/updatedBy; a wrong entry is soft-deleted and superseded.
model UserEvent {
  id        String    @id @default(uuid(7))
  userId    String
  type      String // 'joined_company' | 'position_change' | 'department_change' | ...
  eventDate DateTime  @db.Date
  details   Json      @default("{}")
  source    String // 'system' | 'manual'
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  createdBy String

  user    User @relation("UserEventSubject", fields: [userId], references: [id], onDelete: Cascade)
  creator User @relation("UserEventAuthor", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([userId, type])
  @@map("user_events")
}


enum RelationshipType {
  direct
  project
  people_partner
}

// The org-fact edge table the audience walk recurses over (AD-11). One typed
// row per fact; `reportsToUserId` carries the endpoint for both `direct` and
// `people_partner`, `projectId` for `project`. The shape rule, the
// one-manager/one-PP cardinality and the no-self-report guard are CHECK and
// partial-unique constraints in the migration — Prisma cannot express them.
model Relationship {
  id              String           @id @default(uuid(7))
  userId          String
  type            RelationshipType
  reportsToUserId String?
  projectId       String?

  user      User     @relation("RelationshipSubject", fields: [userId], references: [id], onDelete: Cascade)
  reportsTo User?    @relation("RelationshipReportsTo", fields: [reportsToUserId], references: [id], onDelete: Restrict)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([userId, type])
  // The resolver's hot path filters type + endpoint, in that column order.
  @@index([reportsToUserId, type])
  @@index([projectId])
  @@map("relationships")
}

// Present so `Relationship.projectId` has a real target. Project-line audiences
// stay fail-closed until the timetracker assignment/freshness contract is
// approved, so nothing reads this table yet.
model Project {
  id            String         @id @default(uuid(7))
  name          String
  createdAt     DateTime       @default(now())
  relationships Relationship[]

  @@map("projects")
}


// ---------------------------------------------------------------------------
// Access Control functional-role kernel (AD-4 / FR-AMD-1, SPEC CAP-3).
//
// The type separation this model exists to guarantee is enforced in reviewed
// custom migration SQL, not here: Prisma cannot express the FR/AR row-shape
// CHECK, the PARTIAL unique FR role key, the `Policies(id, type)` support key,
// or the composite foreign key that makes an AR-policy grant impossible. Read
// the migration alongside these models — the models alone understate the
// contract.
// ---------------------------------------------------------------------------

model Policy {
  id         String  @id @default(uuid(7))
  operator   String  @default("==")
  // Polymorphic by design — no database FK, because `targetType` selects the
  // table (AD-10). Both are NULL on FR rows.
  targetType String?
  targetId   String?
  // The FR role key. Unique only among FR rows: an AR policy may legally carry
  // the same `targetRole` and is a different object.
  targetRole String?
  type       String
  managedBy  String

  userPolicies UserPolicy[]
  bootstrap    AccessControlBootstrap?

  @@map("Policies")
}

model Permission {
  id          String @id @default(uuid(7))
  // Immutable lowercase `context:action`. Append-only: no writer updates a key
  // in place.
  key         String @unique
  description String

  grants PolicyPermission[]

  @@map("Permissions")
}

model PolicyPermission {
  policyId     String
  // Stored discriminator. Fixed to 'FR' by CHECK and joined to
  // `Policies(id, type)` by a composite foreign key in the migration, which is
  // what makes an AR-policy grant impossible at the database boundary. There is
  // deliberately NO Prisma relation on `policyId`: a Prisma relation would emit
  // a simple FK to `Policies(id)`, which cannot constrain the type at all.
  policyType   String @default("FR")
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([policyId, permissionId])
  // Permission-first: ACM-2 enters from a permission key, so that column leads.
  // The primary key already covers (policyId, permissionId).
  @@index([permissionId, policyId])
  @@map("PolicyPermissions")
}

model UserPolicy {
  userId   String
  policyId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@id([userId, policyId])
  @@map("UserPolicies")
}

// Durable bootstrap provenance. Its ABSENCE is meaningful — it is what permits
// adoption on a first run — so the singleton is enforced by constraints rather
// than convention.
model AccessControlBootstrap {
  key                 String @id
  normalizedRootEmail String @unique
  rootUserId          String @unique
  policyId            String @unique

  user   User   @relation(fields: [rootUserId], references: [id], onDelete: Restrict)
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@map("AccessControlBootstrap")
}
